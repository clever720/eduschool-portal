# PostgreSQL connection string. Use a managed database URL in production.
DATABASE_URL=postgres://educore_user:change_this_password@localhost:5432/educore

# Generate a random secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Set NODE_ENV=production on your live host. HTTPS is required in production.
NODE_ENV=development
PORT=3000

# Optional: when frontend is hosted on a different origin, set its exact origin.
# FRONTEND_ORIGIN=https://your-educore-site.example
